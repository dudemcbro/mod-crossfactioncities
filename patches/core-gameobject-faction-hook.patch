+void ScriptMgr::OnGameObjectFactionCalc(GameObject const* go, Player const* viewer, uint32& faction)
+{
+    if (!go || !viewer)
+        return;
+
+    ExecuteScript<AllGameObjectScript>([&](AllGameObjectScript* script)
+    {
+        script->OnGameObjectFactionCalc(go, viewer, faction);
+    });
+}
