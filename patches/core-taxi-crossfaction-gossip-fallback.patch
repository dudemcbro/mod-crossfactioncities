+#include <sstream>
+
+namespace
+{
+    // Unique sender id for cross-faction taxi gossip options.
+    constexpr uint32 CFC_TAXI_GOSSIP_SENDER = 0xCFC1CFC1;
+    constexpr uint32 CFC_TAXI_GOSSIP_TEXT_ID = 1; // npc_text entry; 1 exists in base world DB.
+
+    char const* GetTaxiNodeName(uint32 nodeId, LocaleConstant locale)
+    {
+        TaxiNodesEntry const* node = sTaxiNodesStore.LookupEntry(nodeId);
+        if (!node)
+            return nullptr;
+
+        char const* name = node->name[locale];
+        if (!name || !*name)
+            name = node->name[LOCALE_enUS];
+
+        return name;
+    }
+
+    std::string FormatTaxiPrice(uint32 price)
+    {
+        uint32 gold = price / 10000;
+        uint32 silver = (price / 100) % 100;
+        uint32 copper = price % 100;
+
+        std::ostringstream ss;
+        if (gold)
+            ss << gold << "g ";
+        if (gold || silver)
+            ss << silver << "s ";
+        ss << copper << "c";
+        return ss.str();
+    }
+
+    bool IsCrossFactionTaxiNode(uint32 nodeId, TeamId teamId)
+    {
+        TaxiNodesEntry const* node = sTaxiNodesStore.LookupEntry(nodeId);
+        if (!node)
+            return false;
+
+        // DK flight network isn't faction-locked.
+        if (node->MountCreatureID[0] == 32981 || node->MountCreatureID[1] == 32981)
+            return false;
+
+        uint8 teamIndex = teamId == TEAM_ALLIANCE ? 1 : 0;
+        uint8 altTeamIndex = teamIndex ? 0 : 1;
+
+        return node->MountCreatureID[teamIndex] == 0 && node->MountCreatureID[altTeamIndex] != 0;
+    }
+
+    bool TrySendCrossFactionTaxiAsGossip(WorldSession* session, Creature* unit, uint32 sourceNode)
+    {
+        Player* player = session ? session->GetPlayer() : nullptr;
+        if (!session || !player || !unit)
+            return false;
+
+        if (!sWorld->getBoolConfig(CONFIG_ALLOW_TWO_SIDE_INTERACTION_GROUP))
+            return false;
+
+        if (!IsCrossFactionTaxiNode(sourceNode, player->GetTeamId()))
+            return false;
+
+        TaxiPathSetBySource::const_iterator src_i = sTaxiPathSetBySource.find(sourceNode);
+        if (src_i == sTaxiPathSetBySource.end() || src_i->second.empty())
+            return false;
+
+        ClearGossipMenuFor(player);
+
+        // Keep the standard instant-flight toggle available (worldserver.conf: InstantFlightPaths = 2).
+        if (sWorld->getIntConfig(CONFIG_INSTANT_TAXI) == 2 && unit->HasNpcFlag(UNIT_NPC_FLAG_FLIGHTMASTER))
+            AddGossipItemFor(player, GOSSIP_ICON_INTERACT_1, session->GetAcoreString(LANG_TOGGLE_INSTANT_FLIGHT), 0, GOSSIP_ACTION_TOGGLE_INSTANT_FLIGHT);
+
+        LocaleConstant locale = session->GetSessionDbcLocale();
+        for (TaxiPathSetForSource::const_iterator dest_i = src_i->second.begin(); dest_i != src_i->second.end(); ++dest_i)
+        {
+            uint32 destNode = dest_i->first;
+            TaxiPathEntry const* taxiPath = dest_i->second;
+            if (!taxiPath)
+                continue;
+
+            if (!player->isTaxiCheater() && !player->m_taxi.IsTaximaskNodeKnown(destNode))
+                continue;
+
+            char const* destName = GetTaxiNodeName(destNode, locale);
+            std::string text = destName && *destName ? destName : "Unknown flight point";
+
+            if (taxiPath->price)
+            {
+                text += " (";
+                text += FormatTaxiPrice(taxiPath->price);
+                text += ")";
+            }
+
+            AddGossipItemFor(player, GOSSIP_ICON_TAXI, text, CFC_TAXI_GOSSIP_SENDER, destNode);
+        }
+
+        if (player->PlayerTalkClass->GetGossipMenu().Empty())
+            return false;
+
+        SendGossipMenuFor(player, CFC_TAXI_GOSSIP_TEXT_ID, unit);
+        return true;
+    }
+}
