#
# mod-crossfactioncities
#

CrossFactionCities.Enable = 1

###################################################################################################
# NPC NEUTRALITY
#
# NPCs of the other faction are made neutral with forced reactions: the same mechanism disguise
# spells use. The server and the client apply them together, so an NPC that looks neutral never
# attacks and an NPC that looks hostile always does. The reactions are updated when the player
# changes area.
#
# The NPC factions are found automatically: every Faction.dbc faction whose faction templates
# are all in the Alliance group (or all in the Horde group). The worldserver log lists them at
# startup ("Alliance NPC factions" / "Horde NPC factions").
###################################################################################################

# If enabled, NPCs are only neutral in neutral areas: areas flagged as capital, city or town in
# AreaTable.dbc, plus NeutralZoneIds and NeutralAreaIds.
# If disabled, NPCs are neutral everywhere (HostileZoneIds and HostileAreaIds still apply).
CrossFactionCities.OnlyInCities = 1

# If enabled, every area counts as a neutral area (also for PlayerNeutralOnlyInCities and the
# gameobject options).
CrossFactionCities.AllAreasNeutral = 0

# Zone IDs that count as neutral areas.
# Defaults include all playable race starting zones from playercreateinfo.sql.
CrossFactionCities.NeutralZoneIds = "1,12,14,85,141,215,3430,3431,3433,3524,3525,3526"

# Area IDs that count as neutral areas.
CrossFactionCities.NeutralAreaIds = ""

# Zone and area IDs where NPCs always keep their normal hostility, even inside a neutral zone.
# Use these for quest areas full of enemy NPCs of the other faction.
# Defaults: 372 Tiragarde Keep (Durotar), 404 Bael'dun Digsite (Mulgore), 2157 Bael'dun Keep (Barrens).
CrossFactionCities.HostileZoneIds = ""
CrossFactionCities.HostileAreaIds = "372,404,2157"

# If enabled, NPCs are also neutral inside dungeons and raids (when the area rules allow it).
# Keep this disabled: encounters such as the Icecrown gunship or the Faction Champions use
# NPCs of the other faction as enemies.
CrossFactionCities.NeutralInInstances = 0

# Reaction of the other faction's NPCs in neutral areas.
# 3 = Neutral: they do not attack, and they can still be attacked (quest targets stay killable).
# 4 = Friendly: they do not attack and cannot be attacked.
# Reputation that already gives this reaction or better is used as is.
CrossFactionCities.NpcReactionRank = 3

# Faction.dbc IDs to add to the Alliance or Horde NPC factions.
CrossFactionCities.ExtraAllianceFactionIds = ""
CrossFactionCities.ExtraHordeFactionIds = ""

# Faction.dbc IDs whose NPCs are never made neutral.
CrossFactionCities.NeverNeutralFactionIds = ""

###################################################################################################
# PLAYER NEUTRALITY
###################################################################################################

# Make players of the other faction friendly: no PvP except duels, and they can heal and buff
# each other. Never applies in battlegrounds, arenas and Wintergrasp.
CrossFactionCities.PlayerNeutral = 1

# If enabled, players are only friendly when at least one of them is in a neutral area.
CrossFactionCities.PlayerNeutralOnlyInCities = 0

# If enabled, players can fight in world PvP objective zones (Hellfire Peninsula towers, Halaa,
# Eastern Plaguelands towers, Silithus, Zangarmarsh, Terokkar, Grizzly Hills).
CrossFactionCities.WorldPvPZonesHostile = 1

# FactionTemplate ID sent to clients for players (and their pets) of the other faction.
# 0 = use the viewing player's own faction template.
CrossFactionCities.ClientFactionTemplateId = 0

###################################################################################################
# GAMEOBJECTS (need core-gameobject-faction-hook.patch)
###################################################################################################

# Allow using mailboxes of the other faction.
CrossFactionCities.NeutralMailboxes = 1

# If enabled, mailboxes work outside neutral areas too.
CrossFactionCities.MailboxIgnoreCityCheck = 1

# Neutralize opposing-faction-owned gameobjects (chests, cages, etc.) by spoofing the GO faction
# sent to the client. This makes faction-owned interactables targetable/usable cross-faction.
CrossFactionCities.NeutralGameObjects = 1

# If enabled, only neutralize gameobjects in neutral areas.
CrossFactionCities.NeutralGameObjectsOnlyInCities = 0

###################################################################################################
# REPUTATION
###################################################################################################

# If enabled, allow gaining reputation from quests even if the rewarded faction is hostile to the player.
# (AzerothCore normally skips quest reputation rewards for hostile factions.)
CrossFactionCities.AllowHostileQuestReputation = 0

###################################################################################################
# INNS, LANGUAGES AND NPC SPEECH
###################################################################################################

# Let players rest in the other faction's inns and rest areas (Northrend inns, the Dalaran
# pavilions and the like). Takes effect after a worldserver restart.
CrossFactionCities.NeutralInns = 1

# Languages each player knows, checked at every login:
# 0 = only the languages of their own race
# 1 = also the other faction's common language (Orcish for the Alliance, Common for the Horde)
# 2 = every playable race's language
# Lowering the value removes the extra languages at the player's next login.
# Takes effect after a worldserver restart.
CrossFactionCities.LearnLanguages = 0

# Send NPC speech and gossip text that is in a playable race's language as Universal, so every
# player can read it. Players' own clients cache gossip text, so clear the client's Cache folder
# after turning this on.
CrossFactionCities.NpcSpeechUniversal = 1

###################################################################################################
# ITEMS AND ACHIEVEMENTS
###################################################################################################

# Remove the Horde-only and Alliance-only flags and the race limits from items, so every player
# can equip, use, loot and buy them (faction mounts, PvP gear, faction quest items). Reputation
# requirements stay. Takes effect after a worldserver restart; players should clear the client's
# Cache folder so their item tooltips update.
CrossFactionCities.UnlockFactionItems = 0

# Let players of either faction earn the other faction's achievements. The stock client lists
# only its own faction's achievements in the achievement window; the server still tracks and
# awards them. Takes effect after a worldserver restart.
CrossFactionCities.UnlockFactionAchievements = 0
