#
# mod-crossfactioncities
#

CrossFactionCities.Enable = 1

# If enabled, only apply neutrality in areas flagged as capital/city/town in AreaTable.dbc.
CrossFactionCities.OnlyInCities = 1

# If enabled, treat all areas as neutral interaction areas (except battlegrounds/arenas).
CrossFactionCities.AllAreasNeutral = 0

# If enabled, automatically treat creatures flagged as guards as eligible for neutrality.
CrossFactionCities.IncludeGuards = 1

# If enabled, creatures with explicit Alliance/Horde faction-group alignment are eligible.
# This fills gaps when new city faction templates are added later.
CrossFactionCities.UseFactionGroup = 1

# FactionTemplate ID to send to clients for opposing city NPCs.
# 0 = use the player's own faction template (guarantees no hostile sword icon).
CrossFactionCities.ClientFactionTemplateId = 0

# Neutralize opposing-faction players (no PvP except duels), to allow normal interaction.
CrossFactionCities.PlayerNeutral = 1

# If enabled, only neutralize opposing players in city areas.
CrossFactionCities.PlayerNeutralOnlyInCities = 0

# Allow interacting with mailbox NPCs from the opposing faction.
CrossFactionCities.NeutralMailboxes = 1

# If enabled, mailbox NPCs ignore the city-only restriction.
CrossFactionCities.MailboxIgnoreCityCheck = 1

# Neutralize opposing-faction-owned gameobjects (chests, cages, etc.) by spoofing the GO faction
# sent to the client. This makes faction-owned interactables targetable/usable cross-faction.
CrossFactionCities.NeutralGameObjects = 1

# If enabled, only neutralize gameobjects in areas treated as cities/neutral zones/areas.
CrossFactionCities.NeutralGameObjectsOnlyInCities = 0

# If enabled, allow gaining reputation from quests even if the rewarded faction is hostile to the player.
# (AzerothCore normally skips quest reputation rewards for hostile factions.)
CrossFactionCities.AllowHostileQuestReputation = 0

# Additional zone IDs to treat as neutral interaction areas.
# Defaults include all playable race starting zones from playercreateinfo.sql.
CrossFactionCities.NeutralZoneIds = "1,12,14,85,141,215,3430,3431,3433,3524,3525,3526"

# Additional area IDs to treat as neutral interaction areas.
CrossFactionCities.NeutralAreaIds = ""

# Comma-separated creature_template.faction (FactionTemplate ID) values for opposing-faction city NPCs.
# Populate these lists with the faction IDs used by civilian/quest/vendor/trainers in the opposing cities.
CrossFactionCities.AllianceCityFactionIds = ""
CrossFactionCities.HordeCityFactionIds = ""

# Optional guard/defender faction template IDs (FactionTemplate ID), if guards use a separate faction.
CrossFactionCities.GuardFactionIds = ""
